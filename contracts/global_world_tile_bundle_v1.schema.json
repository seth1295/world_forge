                }
              }
            },
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 8
                },
                "x": {
                  "maximum": 368639
                },
                "y": {
                  "maximum": 184319
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 9
                },
                "x": {
                  "maximum": 737279
                },
                "y": {
