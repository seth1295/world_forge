                }
              }
            },
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 10
                },
                "x": {
                  "maximum": 1474559
                },
                "y": {
                  "maximum": 737279
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 11
                },
                "x": {
                  "maximum": 2949119
                },
                "y": {
                  "maximum": 1474559
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 12
                },
                "x": {
                  "maximum": 5898239
                },
