              }
            },
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 4
                },
                "x": {
                  "maximum": 23039
                },
                "y": {
                  "maximum": 11519
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 5
                },
                "x": {
                  "maximum": 46079
                },
                "y": {
                  "maximum": 23039
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 6
                },
