{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worldforge:schema:global-world-tile-bundle:1.0.0",
  "title": "WorldForge Global World Tile Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "bundle_id",
    "created_at_utc",
    "source_id",
    "source_generation",
    "consumer_limit_profile_id",
    "lod",
    "address",
    "tile_origin",
    "producers",
    "layers"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:worldforge:global-world-tile-bundle:1.0.0"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "bundle_id": {
      "$ref": "#/$defs/sha256"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "source_id": {
      "const": "worldforge-global-world-v1"
    },
    "source_generation": {
      "$ref": "#/$defs/sha256"
    },
    "consumer_limit_profile_id": {
      "type": "string",
      "pattern": "^worldforge\\.global-world\\.v1\\.[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 96
    },
    "lod": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "address": {
      "$ref": "#/$defs/address"
    },
    "tile_origin": {
      "$ref": "#/$defs/tile_origin"
    },
    "producers": {
      "$ref": "#/$defs/producers"
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terrain",
        "roads",
        "buildings",
        "water",
        "landcover",
        "vegetation"
      ],
      "properties": {
        "terrain": {
          "$ref": "#/$defs/raster_sample_layer"
        },
        "roads": {
          "$ref": "#/$defs/vector_layer"
        },
        "buildings": {
          "$ref": "#/$defs/vector_layer"
        },
        "water": {
          "$ref": "#/$defs/vector_layer"
        },
        "landcover": {
          "$ref": "#/$defs/raster_pixel_layer"
        },
        "vegetation": {
          "$ref": "#/$defs/raster_pixel_layer"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "address_id": {
      "type": "string",
      "pattern": "^wfg1:(?:0|[1-9]|1[0-6]):(?:0|[1-9][0-9]*):(?:0|[1-9][0-9]*)$",
      "maxLength": 64
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "address_id",
        "level",
        "x",
        "y",
        "tile_bounds",
        "horizontal_crs",
        "horizontal_datum",
        "axis_order",
        "edge_ownership"
      ],
      "properties": {
        "scheme": {
          "const": "WFG-1"
        },
        "address_id": {
          "$ref": "#/$defs/address_id"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 94371839
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 47185919
        },
        "tile_bounds": {
          "$ref": "#/$defs/tile_bounds"
        },
        "horizontal_crs": {
          "const": "EPSG:4326"
        },
        "horizontal_datum": {
          "const": "WGS84"
        },
        "axis_order": {
          "const": [
            "longitude",
            "latitude"
          ]
        },
        "edge_ownership": {
          "const": "west_south_inclusive_east_north_exclusive_north_pole_exception"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 0
                },
                "x": {
                  "maximum": 1439
                },
                "y": {
                  "maximum": 719
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "level": {
                  "const": 1
                },
                "x": {
                  "maximum": 2879
                },
                "y": {
                  "maximum": 1439
                }
              }
            },
            {
              "type": "object",
              "properties": {
