{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worldforge:schema:terrain-grid:1.0.0",
  "title": "WorldForge Terrain Grid Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "artifact_id", "frame_definition_sha256", "producer", "source", "frame", "grid", "payloads", "generation"],
  "properties": {
    "contract_id": { "const": "urn:worldforge:contract:terrain-grid:1.0.0" },
    "artifact_id": { "$ref": "#/$defs/sha256" },
    "frame_definition_sha256": { "$ref": "#/$defs/sha256" },
    "producer": { "$ref": "#/$defs/producer" },
    "source": { "$ref": "#/$defs/source" },
    "frame": { "$ref": "#/$defs/frame" },
    "grid": { "$ref": "#/$defs/grid" },
    "payloads": { "$ref": "#/$defs/payloads" },
    "generation": { "$ref": "#/$defs/generation" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "git_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "uri": { "type": "string", "format": "uri", "maxLength": 2048 },
    "finite_number": { "type": "number", "minimum": -1000000000000, "maximum": 100000000000 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "source_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_offset", "column_offset", "rows", "columns"],
      "properties": {
        "row_offset": { "type": "integer", "minimum": 0, "maximum": 99999 },
        "column_offset": { "type": "integer", "minimum": 0, "maximum": 99999 },
        "rows": { "type": "integer", "minimum": 2, "maximum": 4096 },
        "columns": { "type": "integer", "minimum": 2, "maximum": 4096 }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "commit": { "$ref": "#/$defs/git_commit" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "dataset", "product_id", "product_title", "product_date", "source_uri", "acquired_at_utc", "acquisition_time_basis", "snapshot_verified_date", "raster", "metadata", "product_record", "rights_statement", "uncertainty_statement"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dataset": { "type": "string", "minLength": 1, "maxLength": 128 },
        "product_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "product_title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "product_date": { "type": "string", "format": "date" },
        "source_uri": { "$ref": "#/$defs/uri" },
        "acquired_at_utc": { "type": "string", "format": "date-time", "maxLength": 40 },
        "acquisition_time_basis": { "enum": ["filesystem_creation_time", "recorded_download_receipt"] },
        "snapshot_verified_date": { "type": "string", "format": "date" },
        "raster": {
          "type": "object",
          "additionalProperties": false,
          "required": ["byte_length", "sha256", "width", "height", "band", "dtype", "scale", "offset", "nodata_value", "pixel_interpretation", "horizontal_crs", "horizontal_datum", "ellipsoid", "realization_epoch", "vertical_datum", "vertical_height_type", "vertical_unit", "affine"],
          "properties": {
            "byte_length": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "width": { "type": "integer", "minimum": 2, "maximum": 100000 },
            "height": { "type": "integer", "minimum": 2, "maximum": 100000 },
            "band": { "const": 1 },
            "dtype": { "const": "float32" },
            "scale": { "const": 1 },
            "offset": { "const": 0 },
            "nodata_value": { "$ref": "#/$defs/finite_number" },
            "pixel_interpretation": { "const": "area" },
            "horizontal_crs": { "const": "EPSG:4269" },
            "horizontal_datum": { "const": "NAD83" },
            "ellipsoid": { "const": "GRS80" },
            "realization_epoch": { "const": "unspecified_by_source_metadata" },
            "vertical_datum": { "const": "NAVD88" },
            "vertical_height_type": { "const": "orthometric" },
            "vertical_unit": { "const": "metre" },
            "affine": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x_origin", "y_origin", "pixel_width", "rotation_x", "rotation_y", "pixel_height"],
              "properties": {
                "x_origin": { "$ref": "#/$defs/lon" },
                "y_origin": { "$ref": "#/$defs/lat" },
                "pixel_width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "rotation_x": { "const": 0 },
                "rotation_y": { "const": 0 },
                "pixel_height": { "type": "number", "exclusiveMaximum": 0, "minimum": -1 }
              }
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "byte_length", "sha256"],
          "properties": {
            "uri": { "$ref": "#/$defs/uri" },
            "byte_length": { "type": "integer", "minimum": 1, "maximum": 10485760 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "product_record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "byte_length", "sha256"],
          "properties": {
            "uri": { "$ref": "#/$defs/uri" },
            "byte_length": { "type": "integer", "minimum": 1, "maximum": 10485760 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "rights_statement": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "uncertainty_statement": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "horizontal", "vertical", "origin"],
      "properties": {
        "frame_id": { "type": "string", "pattern": "^wf-vs01:[a-z0-9-]{1,64}$", "maxLength": 72 },
        "horizontal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_crs", "source_axis_order", "datum", "ellipsoid", "realization_epoch", "projection_method", "projection_wkt2", "operation_proj_pipeline", "projected_axis_order", "unit"],
          "properties": {
            "source_crs": { "const": "EPSG:4269" },
            "source_axis_order": { "const": "longitude_latitude" },
            "datum": { "const": "NAD83" },
            "ellipsoid": { "const": "GRS80" },
            "realization_epoch": { "const": "unspecified_by_source_metadata" },
            "projection_method": { "const": "ellipsoidal_azimuthal_equidistant" },
            "projection_wkt2": { "type": "string", "minLength": 1, "maxLength": 8192 },
            "operation_proj_pipeline": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "projected_axis_order": { "const": "easting_northing" },
            "unit": { "const": "metre" }
          }
        },
        "vertical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["datum", "height_type", "unit", "local_up_expression"],
          "properties": {
            "datum": { "const": "NAVD88" },
            "height_type": { "const": "orthometric" },
            "unit": { "const": "metre" },
            "local_up_expression": { "const": "H-H0" }
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_product_id", "source_raster_sha256", "source_row", "source_column", "longitude_deg", "latitude_deg", "height_navd88_m"],
          "properties": {
            "source_product_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "source_raster_sha256": { "$ref": "#/$defs/sha256" },
            "source_row": { "type": "integer", "minimum": 0, "maximum": 99999 },
            "source_column": { "type": "integer", "minimum": 0, "maximum": 99999 },
            "longitude_deg": { "$ref": "#/$defs/lon" },
            "latitude_deg": { "$ref": "#/$defs/lat" },
            "height_navd88_m": { "type": "number", "minimum": -12000, "maximum": 12000 }
          }
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "rows", "columns", "source_window", "sample_order", "sample_stride", "resampling", "source_pixel_footprint_bounds", "projected_sample_bounds_m"],
      "properties": {
        "region_id": { "type": "string", "pattern": "^wf-vs01:[a-z0-9-]{1,64}$", "maxLength": 72 },
        "rows": { "type": "integer", "minimum": 2, "maximum": 4096 },
        "columns": { "type": "integer", "minimum": 2, "maximum": 4096 },
        "source_window": { "$ref": "#/$defs/source_window" },
        "sample_order": { "const": "row_major_north_to_south_west_to_east" },
        "sample_stride": { "const": 1 },
        "resampling": { "const": "none" },
        "source_pixel_footprint_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["west_deg", "south_deg", "east_deg", "north_deg", "crs", "meaning"],
          "properties": {
            "west_deg": { "$ref": "#/$defs/lon" },
            "south_deg": { "$ref": "#/$defs/lat" },
            "east_deg": { "$ref": "#/$defs/lon" },
            "north_deg": { "$ref": "#/$defs/lat" },
            "crs": { "const": "EPSG:4269" },
            "meaning": { "const": "outer_pixel_edges" }
          }
        },
        "projected_sample_bounds_m": {
          "type": "object",
          "additionalProperties": false,
          "required": ["easting_min", "northing_min", "easting_max", "northing_max", "crs", "frame_id", "meaning"],
          "properties": {
            "easting_min": { "type": "number", "minimum": -100000, "maximum": 100000 },
            "northing_min": { "type": "number", "minimum": -100000, "maximum": 100000 },
            "easting_max": { "type": "number", "minimum": -100000, "maximum": 100000 },
            "northing_max": { "type": "number", "minimum": -100000, "maximum": 100000 },
            "crs": { "const": "regional_frame" },
            "frame_id": { "type": "string", "minLength": 1, "maxLength": 72 },
            "meaning": { "const": "sample_centres" }
          }
        }
      }
    },
    "payloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizontal_xy", "height_samples"],
      "properties": {
        "horizontal_xy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "encoding", "byte_length", "sha256"],
          "properties": {
            "path": { "const": "horizontal_xy.f64le" },
            "encoding": { "const": "ieee754_binary64_le_easting_northing_pairs" },
            "byte_length": { "type": "integer", "minimum": 64, "maximum": 67108864 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "height_samples": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "encoding", "byte_length", "sha256"],
          "properties": {
            "path": { "const": "height_samples.f32le" },
            "encoding": { "const": "ieee754_binary32_le_metres" },
            "byte_length": { "type": "integer", "minimum": 16, "maximum": 16777216 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_utc", "source_window", "resampling", "tool_versions"],
      "properties": {
        "created_utc": { "type": "string", "format": "date-time", "maxLength": 40 },
        "source_window": { "$ref": "#/$defs/source_window" },
        "resampling": { "const": "none" },
        "tool_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python", "rasterio", "gdal", "proj"],
          "properties": {
            "python": { "type": "string", "minLength": 1, "maxLength": 64 },
            "rasterio": { "type": "string", "minLength": 1, "maxLength": 64 },
            "gdal": { "type": "string", "minLength": 1, "maxLength": 64 },
            "proj": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    }
  }
}